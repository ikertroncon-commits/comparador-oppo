rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Sustituye PEGA_AQUI_TU_UID por tu UID de administrador
    function isAdmin() { return signedIn() && request.auth.uid == "PEGA_AQUI_TU_UID"; }
    // Vendedor autorizado: su correo está en la lista "vendedores"
    function isVendor() {
      return signedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/vendedores/$(request.auth.token.email.lower()));
    }

    // Lista de vendedores: cada uno solo puede comprobar si él está; solo el administrador la cambia
    match /vendedores/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Dispositivo vinculado de cada vendedor: lo registra él la primera vez; solo el administrador lo libera
    match /dispositivos/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow create: if signedIn() && request.auth.token.email.lower() == email;
      allow update, delete: if isAdmin();
    }

    // Ajustes de acceso (si la lista está activada)
    match /ajustes/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Resto de datos: solo administrador y vendedores autorizados pueden verlos; solo el administrador los cambia
    match /{col}/{doc=**} {
      allow read: if col != "vendedores" && col != "dispositivos" && (isAdmin() || isVendor());
      allow write: if isAdmin();
    }
  }
}
